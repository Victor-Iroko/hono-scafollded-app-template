{
  "openapi": "3.1.0",
  "info": {
    "title": "Hono Scaffolded App API",
    "version": "1.0.0",
    "description": "HTTP API for the scaffolded application."
  },
  "paths": {
    "/healthz": {
      "get": {
        "tags": ["health"],
        "operationId": "getHealth",
        "parameters": [],
        "security": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "enum": [true]
                    }
                  },
                  "required": ["ok"],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/BadRequestProblemEncoded"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/InternalServerErrorProblemEncoded"
                }
              }
            }
          }
        },
        "summary": "Check whether the process is alive"
      }
    },
    "/readyz": {
      "get": {
        "tags": ["health"],
        "operationId": "getReadiness",
        "parameters": [],
        "security": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "enum": [true]
                    },
                    "checks": {
                      "type": "object",
                      "properties": {
                        "database": {
                          "type": "object",
                          "properties": {
                            "ok": {
                              "type": "boolean"
                            },
                            "latencyMs": {
                              "anyOf": [
                                {
                                  "type": "number"
                                },
                                {
                                  "type": "string",
                                  "enum": ["Infinity", "-Infinity", "NaN"]
                                }
                              ]
                            }
                          },
                          "required": ["ok", "latencyMs"],
                          "additionalProperties": false
                        }
                      },
                      "required": ["database"],
                      "additionalProperties": false
                    }
                  },
                  "required": ["ok", "checks"],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/BadRequestProblemEncoded"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/InternalServerErrorProblemEncoded"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/NotReadyEncoded"
                }
              }
            }
          }
        },
        "summary": "Check whether the service can take traffic"
      }
    }
  },
  "components": {
    "schemas": {
      "InternalServerErrorProblemEncoded": {
        "type": "object",
        "properties": {
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": ["about:blank"]
          },
          "status": {
            "type": "number",
            "enum": [500]
          },
          "title": {
            "type": "string",
            "enum": ["Internal Server Error"]
          }
        },
        "required": ["type"],
        "additionalProperties": false
      },
      "BadRequestProblemEncoded": {
        "type": "object",
        "properties": {
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "number"
                      },
                      {
                        "type": "string",
                        "enum": ["Infinity", "-Infinity", "NaN"]
                      }
                    ]
                  }
                },
                "message": {
                  "type": "string"
                }
              },
              "required": ["path", "message"],
              "additionalProperties": false
            }
          },
          "type": {
            "type": "string",
            "enum": ["about:blank"]
          },
          "status": {
            "type": "number",
            "enum": [400]
          },
          "title": {
            "type": "string",
            "enum": ["Bad Request"]
          }
        },
        "required": ["type"],
        "additionalProperties": false
      },
      "NotReadyEncoded": {
        "type": "object",
        "properties": {
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "draining": {
            "type": "boolean"
          },
          "checks": {
            "type": "object",
            "properties": {
              "database": {
                "type": "object",
                "properties": {
                  "ok": {
                    "type": "boolean"
                  },
                  "latencyMs": {
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "string",
                        "enum": ["Infinity", "-Infinity", "NaN"]
                      }
                    ]
                  }
                },
                "required": ["ok", "latencyMs"],
                "additionalProperties": false
              }
            },
            "required": ["database"],
            "additionalProperties": false
          },
          "type": {
            "type": "string",
            "enum": ["about:blank"]
          },
          "status": {
            "type": "number",
            "enum": [503]
          },
          "title": {
            "type": "string",
            "enum": ["Service Unavailable"]
          }
        },
        "required": ["draining", "checks", "type"],
        "additionalProperties": false
      }
    },
    "securitySchemes": {}
  },
  "security": [],
  "tags": [
    {
      "name": "health",
      "description": "Liveness and readiness probes."
    }
  ]
