{
  "name": "hono-scafollded-app-template",
  "scripts": {
    "dev": "bun run --watch src/main.ts",
    "start": "bun run src/main.ts",
    "prepare": "husky",
    "lint": "oxlint",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/migrate.ts",
    "db:push": "drizzle-kit push",
    "test": "bun test",
    "test:unit": "bun test tests/unit",
    "test:integration": "bun test tests/integration",
    "test:coverage": "bun test --coverage"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@better-auth/drizzle-adapter": "^1.7.12",
    "@effect/platform-bun": "4.1.5",
    "@effect/sql-pg": "4.1.5",
    "@scalar/openapi-to-markdown": "^1.6.1",
    "@sentry/effect": "11.16.0",
    "better-auth": "^1.7.12",
    "drizzle-orm": "1.0.0-rc.6",
    "effect": "4.1.5",
    "nodemailer": "^10.1.7",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "1.0.0-rc.6",
    "drizzle-seed": "^0.3.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "oxlint --fix",
      "oxfmt --write"
    ],
    "*.{mjs,cjs,mts,cts,json,jsonc,json5,css,scss,less,pcss,postcss,graphql,gql,graphqls,toml,yml,yaml,markdown,mdx,html,htm,xhtml,vue,svelte,astro,hbs,handlebars,mjml}": [
      "oxfmt --write"
    ]
  }
}
