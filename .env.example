# Copy to .env for local development. Replace example credentials and secrets
# before deploying; do not use these development defaults in production.
NODE_ENV=development
LOG_LEVEL=info

DATABASE_URL=postgres://postgres:postgres@localhost:5432/app_db

# Optional, defaults shown
# DB_POOL_MAX=10
# DB_IDLE_TIMEOUT_MS=30000
# DB_CONNECT_TIMEOUT_MS=10000

# Redis (docker-compose.yml provisions redis-stack on 6379)
# Format: redis://[:password@]host:port/db  (rediss:// enables TLS)
# Password must match REDIS_PASSWORD below.
REDIS_URL=redis://:redis@localhost:6379/0

# Optional, defaults shown
# RATE_LIMIT_POINTS=100
# RATE_LIMIT_DURATION_S=60

# Jobs Redis (BullMQ). Separate from the cache above: it must run with
# maxmemory-policy=noeviction and persistence so jobs are not evicted.
REDIS_JOBS_URL=redis://:redis@localhost:6381/0

# Optional, defaults shown
# QUEUE_PREFIX=bull
# JOB_MAX_ATTEMPTS=3

# S3 / object storage (docker-compose.yml provisions RustFS on 9000)
# Target AWS S3: drop S3_ENDPOINT and S3_ACCESS_KEY_ID/S3_SECRET_ACCESS_KEY to
# use the default credential chain, and set S3_FORCE_PATH_STYLE=false.
S3_BUCKET=app-bucket
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=rustfsadmin
S3_SECRET_ACCESS_KEY=rustfsadmin
S3_ENDPOINT=http://localhost:9000
# Set true locally so the app creates the bucket on boot instead of erroring.
S3_AUTO_CREATE_BUCKET=true

# Optional, defaults shown
# S3_FORCE_PATH_STYLE=true
# S3_PRESIGN_EXPIRES_S=3600
# Presigned URLs are signed against this host. Set it when the app runs in a
# container (internal name) but browsers must reach the storage host instead.
# S3_PUBLIC_ENDPOINT=http://localhost:9000

# Email (docker-compose.yml provisions Mailpit on 1025)
# Mail goes out over SMTP, so any relay works: Mailpit locally, or SES,
# Postmark, Mailgun, etc. in production. Host, TLS, and tuneables live in the
# URL, e.g. smtp://host:587?pool=true&connectionTimeout=10000
EMAIL_FROM="Your App <no-reply@example.test>"
SMTP_URL=smtp://localhost:1025

# Relay credentials, when it needs them: both or neither. Injected into
# SMTP_URL at startup, so a password containing @ or : needs no escaping.
# SMTP_USER=
# SMTP_PASSWORD=

# Optional, defaults shown
# EMAIL_REPLY_TO=support@acme.test
# EMAIL_RATE_MAX=10

# Paystack (only needed when using src/integrations/payments)
# PAYSTACK_SECRET_KEY=sk_test_...

# Observability (optional)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# SENTRY_DSN=
# METRICS_TOKEN=

# API documentation (disabled unless explicitly enabled)
# DOCS_ENABLED=true

# docker compose (not read by the app)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app_db
POSTGRES_PORT=5432
REDIS_PASSWORD=redis
REDIS_PORT=6379
REDIS_JOBS_PORT=6381
REDIS_INSIGHT_PORT=8001
S3_PORT=9000
S3_CONSOLE_PORT=9001
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# docker-compose.test.yml
POSTGRES_DB_TEST=app_db_test
POSTGRES_PORT_TEST=5433
REDIS_PORT_TEST=6380
S3_BUCKET_TEST=app-bucket-test
S3_PORT_TEST=9090
MAILPIT_SMTP_PORT_TEST=1026
MAILPIT_UI_PORT_TEST=8026
